<?xml version="1.0" encoding="UTF-8"?>
<!--
    logback-test.xml
    Configuración de logging para el ciclo de pruebas con Karate DSL.
    Ubicado en src/test/resources para ser cargado durante mvn test.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Appender para consola con patrón legible -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender para archivo de log (opcional, útil en CI) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/karate-test.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/karate-test.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger específico de Karate: nivel INFO para no saturar consola -->
    <logger name="com.intuit.karate" level="INFO" />
    <logger name="io.karatelabs"     level="INFO" />

    <!-- Logger para los runners JUnit 5 -->
    <logger name="com.demoblaze"     level="DEBUG" />

    <!-- Root logger -->
    <root level="WARN">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE"   />
    </root>

</configuration>
